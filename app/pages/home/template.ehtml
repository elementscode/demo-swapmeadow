import "./style.css";
import { LiveView } from "@elements/app";
import { SiteHeader } from "#app/shared/templates/site-header";
import { ListingCard } from "#app/shared/templates/listing-card";
import { Inbox } from "#app/shared/services/conversations";
import { Listing, Category, SearchFilter, CATEGORIES, matchesFilter, isFilterEmpty } from "#app/shared/services/listings";
import { SavedListing, SavedSearch } from "#app/shared/services/saved";
import { Button } from "@elements/ui/button";
import { Input } from "@elements/ui/input";
import { InputGroup, InputGroupAddon } from "@elements/ui/input-group";
import { Icon } from "@elements/ui/icon";
import { ToggleGroup, ToggleGroupItem } from "@elements/ui/toggle-group";
import { NativeSelect } from "@elements/ui/native-select";
import { Checkbox } from "@elements/ui/checkbox";
import { Label } from "@elements/ui/label";
import { Empty } from "@elements/ui/empty";

export interface BrowseState {
  query: string;
  category: Category | "";
  price: "any" | "free" | "25" | "100" | "250";
  showSold: boolean;
}

export const PRICE_OPTIONS = [
  { value: "any", label: "Any price" },
  { value: "free", label: "Free" },
  { value: "25", label: "Under $25" },
  { value: "100", label: "Under $100" },
  { value: "250", label: "Under $250" },
];

function toFilter(state: BrowseState): SearchFilter {
  return {
    query: state.query.trim(),
    category: state.category || null,
    maxPrice: state.price === "any" || state.price === "free" ? null : Number(state.price),
    freeOnly: state.price === "free",
  };
}

function visible(listings: LiveView<Listing>, state: BrowseState): Listing[] {
  let filter = toFilter(state);

  // Sold rows sink to the bottom rather than vanish, so a neighbor who was
  // watching one sees it change instead of disappear.
  return listings
    .filter((l) => (state.showSold || l.status !== "sold") && matchesFilter(l, filter))
    .sort((a, b) => Number(a.status === "sold") - Number(b.status === "sold") || +b.createdAt - +a.createdAt);
}

function sameFilter(s: SavedSearch, f: SearchFilter): boolean {
  return s.query.toLowerCase() === f.query.toLowerCase()
    && (s.category ?? null) === f.category
    && (s.maxPrice ?? null) === f.maxPrice
    && s.freeOnly === f.freeOnly;
}

function isSearchSaved(searches: LiveView<SavedSearch>, state: BrowseState): boolean {
  let filter = toFilter(state);
  return searches.some((s) => sameFilter(s, filter));
}

function onSaveSearch(searches: LiveView<SavedSearch>, state: BrowseState, me: string, neighborhoodId: string) {
  let filter = toFilter(state);

  if (isFilterEmpty(filter) || searches.some((s) => sameFilter(s, filter))) {
    return;
  }

  searches.insert({
    userId: me,
    neighborhoodId,
    ...filter,
    createdAt: new Date(),
    lastNotifiedAt: null,
  });
}

function onClear(state: BrowseState) {
  state.query = "";
  state.category = "";
  state.price = "any";
}

function forSaleCount(listings: LiveView<Listing>): number {
  return listings.filter((l) => l.status !== "sold").length;
}

<html lang="en" class="page-home" (
  me: string,
  neighborhoodId: string,
  neighborhoodName: string,
  listings: LiveView<Listing>,
  saved: LiveView<SavedListing>,
  searches: LiveView<SavedSearch>,
  inbox: Inbox,
  state: BrowseState,
)>
  <head>
    <title>{neighborhoodName} · swapmeadow</title>
    <meta name="description" content="Things for sale and free in your neighborhood.">
  </head>
  <body>
    <div class="app">
      <SiteHeader active="browse" {inbox} />

      <main class="app-main page-shell browse stack is-lg">
        <div class="browse-head row">
          <div class="stack is-xs">
            <h1>{neighborhoodName}</h1>
            <p class="browse-count">{forSaleCount(listings)} things for sale or free, from your neighbors</p>
          </div>
          <Button variant="primary" href="/sell">Post a listing</Button>
        </div>

        <div class="stack is-md">
          <InputGroup>
            <Input type="search" value={state.query} placeholder="Search bikes, strollers, tomato plants…" attrs={{ "aria-label": "Search listings" }} />
            <InputGroupAddon><Icon name="search" size={18} /></InputGroupAddon>
          </InputGroup>

          <ToggleGroup type="single"
                       class="category-filter"
                       variant="outline"
                       size="sm"
                       label="Category"
                       value={state.category || "all"}
                       onValueChange={(value, details) => { details.cancel(); state.category = value === "all" ? "" : value as Category | ""; }}>
            <ToggleGroupItem value="all">All</ToggleGroupItem>
            <ToggleGroupItem e:for={c of CATEGORIES} value={c.id}>{c.label}</ToggleGroupItem>
          </ToggleGroup>

          <div class="browse-filters row">
            <div class="browse-price cluster">
              <NativeSelect value={state.price} size="sm" options={PRICE_OPTIONS} attrs={{ "aria-label": "Price" }} />
              <Label><Checkbox checked={state.showSold} /> Show sold</Label>
            </div>

            <div class="cluster is-sm">
              <Button e:if={!isFilterEmpty(toFilter(state))} variant="ghost" size="sm" onclick={() => onClear(state)}>Clear</Button>
              <Button e:if={isSearchSaved(searches, state)} variant="ghost" size="sm" class="save-search" disabled>Search saved</Button>
              <Button e:elseif={!isFilterEmpty(toFilter(state))}
                      size="sm"
                      class="save-search"
                      onclick={() => onSaveSearch(searches, state, me, neighborhoodId)}>
                Save search, email me new matches
              </Button>
            </div>
          </div>
        </div>

        <ul e:if={visible(listings, state).length > 0} class="listing-grid">
          <ListingCard e:for={listing of visible(listings, state)} {listing} {saved} {me} />
        </ul>

        <Empty e:else variant="outline" class="flex-none" title="Nothing matches yet." description="Save this search and we'll email you when a neighbor posts one." />
      </main>
    </div>
  </body>
</html>
