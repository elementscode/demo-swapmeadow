import "./style.css";
import { LiveView, redirect } from "@elements/app";
import { SiteHeader } from "#app/shared/templates/site-header";
import { StatusPill } from "#app/shared/templates/listing-card";
import { Inbox, contactSeller } from "#app/shared/services/conversations";
import { SavedListing, isSaved, toggleSaved } from "#app/shared/services/saved";
import {
  Listing,
  ListingPhoto,
  Status,
  photoUrl,
  formatPrice,
  categoryLabel,
  conditionLabel,
  timeAgo,
  setStatus,
} from "#app/shared/services/listings";
import { Button } from "@elements/ui/button";
import { Card, CardContent } from "@elements/ui/card";
import { Field } from "@elements/ui/field";
import { Textarea } from "@elements/ui/textarea";
import { Icon } from "@elements/ui/icon";
import { ToggleGroup, ToggleGroupItem } from "@elements/ui/toggle-group";

interface Composer {
  body: string;
  error: string;
  sending: boolean;
}

const STATUS_OPTIONS: { id: Status; label: string }[] = [
  { id: "available", label: "Available" },
  { id: "pending", label: "Pending" },
  { id: "sold", label: "Sold" },
];

function firstName(name: string): string {
  return name.split(" ")[0];
}

function onContact(listing: Listing, composer: Composer) {
  composer.error = "";
  composer.sending = true;

  try {
    let id = contactSeller(listing.id, composer.body);
    redirect(`/messages/${id}`);
  } catch (err: any) {
    composer.error = err.message;
    composer.sending = false;
  }
}

function inquiries(inbox: Inbox, listingId: string) {
  return inbox.selling
    .filter((c) => c.listingId === listingId)
    .sort((a, b) => +b.lastMessageAt - +a.lastMessageAt);
}

<Gallery (photos: ListingPhoto[], title: string, private current: { index: number } = { index: 0 })>
  <div class="stack is-sm">
    <div class="gallery-main">
      <img e:if={photos.length > 0} src={photoUrl(photos[current.index])} alt={title} width="900" height="675">
    </div>

    <div e:if={photos.length > 1} class="gallery-thumbs row">
      <button e:for={photo of photos}
              type="button"
              class={["gallery-thumb", photos.indexOf(photo) === current.index && "is-active"]}
              aria-label={`Photo ${photos.indexOf(photo) + 1}`}
              onclick={() => current.index = photos.indexOf(photo)}>
        <img src={photoUrl(photo)} alt="" width="80" height="60">
      </button>
    </div>

    <p e:if={photos[current.index]?.credit} class="photo-credit">{photos[current.index].credit}</p>
  </div>
</Gallery>

<SellerPanel (listing: Listing, view: LiveView<Listing>, inbox: Inbox)>
  <Card>
    <CardContent class="stack is-md">
      <div class="stack is-xs">
        <strong>This is your listing</strong>
        <p class="hint">Neighbors watching it see the change right away.</p>
      </div>

      <ToggleGroup type="single"
                   class="status-switch"
                   variant="outline"
                   spacing={0}
                   label="Listing status"
                   value={listing.status}
                   onValueChange={(value, details) => { details.cancel(); if (value) setStatus(view, listing, value as Status); }}>
        <ToggleGroupItem e:for={option of STATUS_OPTIONS} value={option.id}>{option.label}</ToggleGroupItem>
      </ToggleGroup>

      <div e:if={inquiries(inbox, listing.id).length > 0} class="stack is-xs inquiries">
        <strong class="text-sm">Messages about this</strong>
        <a e:for={c of inquiries(inbox, listing.id)} href={`/messages/${c.id}`}>
          {c.buyerName}
          <span>{c.lastMessageBody}</span>
        </a>
      </div>
    </CardContent>
  </Card>
</SellerPanel>

<BuyerPanel (
  listing: Listing,
  conversationId: string | null,
  private composer: Composer = { body: `Hi ${firstName(listing.sellerName)}, is this still available?`, error: "", sending: false },
)>
  <Card>
    <CardContent e:if={conversationId} class="stack is-sm">
      <strong>You're talking with {firstName(listing.sellerName)} about this.</strong>
      <Button variant="primary" block href={`/messages/${conversationId}`}>Open conversation</Button>
    </CardContent>

    <CardContent e:elseif={listing.status === "sold"} class="stack is-xs">
      <strong>This one's sold.</strong>
      <p class="hint">Save a search from the browse page and we'll email you when something like it comes up.</p>
    </CardContent>

    <CardContent e:else>
      <form class="stack is-sm" onsubmit={() => onContact(listing, composer)}>
        <Field label={`Message ${firstName(listing.sellerName)}`}
               description={listing.status === "pending" ? "Pending with another neighbor. You can still ask to be next in line." : ""}
               error={composer.error}>
          <Textarea value={composer.body} rows={3} required />
        </Field>
        <Button type="submit" variant="primary" block loading={composer.sending}>Send</Button>
      </form>
    </CardContent>
  </Card>
</BuyerPanel>

<ListingDetails (
  listing: Listing,
  view: LiveView<Listing>,
  photos: ListingPhoto[],
  me: string,
  saved: LiveView<SavedListing>,
  inbox: Inbox,
  conversationId: string | null,
)>
  <div class="listing-layout">
    <Gallery {photos} title={listing.title} />

    <div class="listing-info stack is-lg">
      <div class="stack is-sm">
        <div class="cluster is-sm">
          <span class={["listing-price", listing.price === 0 && "is-free"]}>{formatPrice(listing.price)}</span>
          <StatusPill status={listing.status} />
        </div>
        <h1>{listing.title}</h1>
        <p class="hint">Posted {timeAgo(listing.createdAt)} by {listing.sellerName}</p>
      </div>

      <SellerPanel e:if={listing.sellerId === me} {listing} {view} {inbox} />
      <BuyerPanel e:else {listing} {conversationId} />

      <div e:if={listing.sellerId !== me}>
        <Button variant="ghost"
                class="listing-save"
                attrs={{ "data-saved": isSaved(saved, listing.id) || undefined }}
                onclick={() => toggleSaved(saved, listing.id, me)}>
          <Icon name="heart" />
          {isSaved(saved, listing.id) ? "Saved" : "Save for later"}
        </Button>
      </div>

      <dl class="listing-facts">
        <dt>Category</dt>
        <dd>{categoryLabel(listing.category)}</dd>
        <dt>Condition</dt>
        <dd>{conditionLabel(listing.condition)}</dd>
        <dt>Seller</dt>
        <dd>{listing.sellerName}</dd>
      </dl>

      <p e:if={listing.description} class="listing-description">{listing.description}</p>
    </div>
  </div>
</ListingDetails>

<html lang="en" class="page-listing" (
  me: string,
  listing: LiveView<Listing>,
  photos: ListingPhoto[],
  saved: LiveView<SavedListing>,
  inbox: Inbox,
  conversationId: string | null,
)>
  <head>
    <title>{listing.at(0)?.title ?? "Listing"} · swapmeadow</title>
    <meta name="description" content={listing.at(0)?.description ?? ""}>
  </head>
  <body>
    <div class="app">
      <SiteHeader active="browse" {inbox} />

      <main class={["app-main", "page-shell", "listing-page", "stack", "is-md", listing.at(0)?.status === "sold" && "is-sold"]}>
        <a class="listing-back" href="/">← Back to listings</a>

        <ListingDetails e:for={row of listing}
                        listing={row}
                        view={listing}
                        {photos}
                        {me}
                        {saved}
                        {inbox}
                        {conversationId} />
      </main>
    </div>
  </body>
</html>
