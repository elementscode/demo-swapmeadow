import "./style.css";
import { SiteHeader } from "#app/shared/templates/site-header";
import { Inbox, Conversation, inboxRows, isUnread } from "#app/shared/services/conversations";
import { timeAgo } from "#app/shared/services/listings";
import { Badge } from "@elements/ui/badge";
import { Button } from "@elements/ui/button";
import { Empty, EmptyContent } from "@elements/ui/empty";
import { Item, ItemActions, ItemContent, ItemGroup, ItemMedia, ItemSeparator, ItemTitle } from "@elements/ui/item";

function otherName(c: Conversation, me: string): string {
  return c.buyerId === me ? c.sellerName : c.buyerName;
}

<InboxRow (c: Conversation, me: string, first: boolean)>
  <ItemSeparator e:if={!first} />
  <Item href={`/messages/${c.id}`} class={isUnread(c, me) ? "inbox-row is-unread" : "inbox-row"}>
    <ItemMedia><img class="inbox-thumb" src={c.listingCover ?? ""} alt="" width="56" height="56"></ItemMedia>
    <ItemContent>
      <ItemTitle class="inbox-who">
        {otherName(c, me)}
        <Badge variant={c.sellerId === me ? "accent" : "secondary"}>{c.sellerId === me ? "Selling" : "Buying"}</Badge>
      </ItemTitle>
      <span class="inbox-listing">{c.listingTitle}</span>
      <span class="inbox-last">{c.lastSenderId === me ? "You: " : ""}{c.lastMessageBody}</span>
    </ItemContent>
    <ItemActions class="inbox-when">
      {timeAgo(c.lastMessageAt)}
      <span e:if={isUnread(c, me)} class="unread-dot" aria-label="Unread"></span>
    </ItemActions>
  </Item>
</InboxRow>

<html lang="en" class="page-messages" (me: string, inbox: Inbox)>
  <head>
    <title>Messages · swapmeadow</title>
    <meta name="description" content="Your conversations with neighbors.">
  </head>
  <body>
    <div class="app">
      <SiteHeader active="messages" {inbox} />

      <main class="app-main page-shell is-form inbox stack is-lg">
        <h1>Messages</h1>

        <ItemGroup e:if={inboxRows(inbox).length > 0} class="inbox-list" label="Conversations">
          <InboxRow e:for={c of inboxRows(inbox)} {c} {me} first={inboxRows(inbox).indexOf(c) === 0} />
        </ItemGroup>

        <div e:else>
          <Empty variant="outline" title="No conversations yet." description="Message a seller from any listing and the conversation shows up here.">
            <EmptyContent><Button href="/">Browse listings</Button></EmptyContent>
          </Empty>
        </div>
      </main>
    </div>
  </body>
</html>
