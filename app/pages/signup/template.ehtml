import "./style.css";
import { redirect, ValidationError } from "@elements/app";
import { signup, SignupForm, Neighborhood, MIN_PASSWORD } from "#app/shared/services/auth";
import { Logo } from "#app/shared/templates/site-header";
import { Alert } from "@elements/ui/alert";
import { Button } from "@elements/ui/button";
import { Field, FieldContent, FieldDescription, FieldLabel, FieldLegend, FieldSet, FieldTitle } from "@elements/ui/field";
import { Icon } from "@elements/ui/icon";
import { Input } from "@elements/ui/input";
import { RadioGroup, RadioGroupItem } from "@elements/ui/radio-group";

type Errors = Partial<Record<keyof SignupForm | "form", string[]>>;

function onSubmit(form: SignupForm, state: { errors: Errors }) {
  try {
    signup(form);
    state.errors = {};
    redirect("/");
  } catch (err: any) {
    state.errors = err instanceof ValidationError && err.errors ? err.errors : { form: [err.message] };
  }
}

<html lang="en" class="page-signup" (
  neighborhoods: Neighborhood[],
  private form: SignupForm = { name: "", email: "", password: "", neighborhoodId: "" },
  private state: { errors: Errors } = { errors: {} },
)>
  <head>
    <title>Join · swapmeadow</title>
    <meta name="description" content="Join your neighborhood on swapmeadow.">
  </head>
  <body>
    <div class="auth">
      <section class="auth-story">
        <a class="site-brand" href="/signin"><Logo /> swapmeadow</a>

        <div class="auth-pitch stack is-md">
          <h1>Pass it on, down the street.</h1>
          <p class="lede">Everything you see is from your own neighborhood, so a listing is a short walk away.</p>
        </div>

        <p class="hint">Already a member? <a href="/signin">Sign in</a></p>
      </section>

      <main class="auth-panel">
        <form class="auth-form stack is-md" onsubmit={() => onSubmit(form, state)}>
          <h2>Join your neighborhood</h2>

          <Alert e:if={state.errors.form} variant="danger" description={state.errors.form?.[0] ?? ""}>
            <Icon name="alert-circle" />
          </Alert>

          <Field label="Your name" error={state.errors.name?.[0] ?? ""}>
            <Input name="name" value={form.name} placeholder="Jess" required attrs={{ autocomplete: "given-name" }} />
          </Field>

          <Field label="Email" error={state.errors.email?.[0] ?? ""}>
            <Input type="email"
                   name="email"
                   value={form.email}
                   placeholder="you@example.com"
                   required
                   attrs={{ autocomplete: "email", autocapitalize: "none", spellcheck: "false" }} />
          </Field>

          <Field label="Password" description={`At least ${MIN_PASSWORD} characters.`} error={state.errors.password?.[0] ?? ""}>
            <Input type="password"
                   name="password"
                   value={form.password}
                   required
                   attrs={{ autocomplete: "new-password", minlength: MIN_PASSWORD }} />
          </Field>

          <FieldSet>
            <FieldLegend variant="label">Neighborhood</FieldLegend>
            <RadioGroup name="neighborhood" class="hood-options" value={form.neighborhoodId} attrs={{ "aria-label": "Neighborhood" }}>
              <FieldLabel e:for={n of neighborhoods}>
                <Field orientation="horizontal" reserveError={false}>
                  <RadioGroupItem value={n.id} />
                  <FieldContent>
                    <FieldTitle>{n.name}</FieldTitle>
                    <FieldDescription>{n.area}</FieldDescription>
                  </FieldContent>
                </Field>
              </FieldLabel>
            </RadioGroup>
            <p e:if={state.errors.neighborhoodId} class="error">{state.errors.neighborhoodId?.[0]}</p>
          </FieldSet>

          <Button type="submit" variant="primary" block>Create account</Button>
        </form>
      </main>
    </div>
  </body>
</html>
