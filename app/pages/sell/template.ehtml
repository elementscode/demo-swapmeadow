import "./style.css";
import { redirect, ValidationError } from "@elements/app";
import { SiteHeader } from "#app/shared/templates/site-header";
import { Inbox } from "#app/shared/services/conversations";
import { ListingForm, CATEGORIES, CONDITIONS, MAX_PHOTOS, createListing } from "#app/shared/services/listings";
import { Alert } from "@elements/ui/alert";
import { Button } from "@elements/ui/button";
import { Checkbox } from "@elements/ui/checkbox";
import { Field, FieldSet, FieldLegend } from "@elements/ui/field";
import { FileUpload } from "@elements/ui/file-upload";
import { Icon } from "@elements/ui/icon";
import { Input } from "@elements/ui/input";
import { InputGroup, InputGroupAddon, InputGroupText } from "@elements/ui/input-group";
import { Label } from "@elements/ui/label";
import { NativeSelect } from "@elements/ui/native-select";
import { Textarea } from "@elements/ui/textarea";
import { ToggleGroup, ToggleGroupItem } from "@elements/ui/toggle-group";

const CATEGORY_OPTIONS = CATEGORIES.map((c) => ({ value: c.id, label: c.label }));

type Errors = Partial<Record<keyof ListingForm | "form", string[]>>;

interface Submit {
  errors: Errors;
  saving: boolean;
}

function onSubmit(form: ListingForm, submit: Submit) {
  submit.saving = true;

  try {
    let id = createListing(form);
    redirect(`/listings/${id}`);
  } catch (err: any) {
    submit.errors = err instanceof ValidationError && err.errors ? err.errors : { form: [err.message] };
    submit.saving = false;
  }
}

<html lang="en" class="page-sell" (
  neighborhoodName: string,
  inbox: Inbox,
  private form: ListingForm = { title: "", price: "", free: false, category: "", condition: "good", description: "", photos: [] },
  private submit: Submit = { errors: {}, saving: false },
)>
  <head>
    <title>Post a listing · swapmeadow</title>
    <meta name="description" content="Sell or give away something to your neighbors.">
  </head>
  <body>
    <div class="app">
      <SiteHeader active="sell" {inbox} />

      <main class="app-main page-shell is-form sell stack is-lg">
        <div class="stack is-xs">
          <h1>Post a listing</h1>
          <p class="hint">Neighbors in {neighborhoodName} see it right away. Anyone with a matching saved search gets an email.</p>
        </div>

        <form class="stack is-lg" onsubmit={() => onSubmit(form, submit)}>
          <Alert e:if={submit.errors.form} variant="danger" description={submit.errors.form?.[0] ?? ""}>
            <Icon name="alert-circle" />
          </Alert>

          <Field label="Photos" error={submit.errors.photos?.[0] ?? ""}>
            <FileUpload files={form.photos}
                        accept={["image/png", "image/jpeg", "image/gif", "image/webp"]}
                        maxFiles={MAX_PHOTOS}
                        hint={`Up to ${MAX_PHOTOS}. The first one is the cover.`}
                        invalid={!!submit.errors.photos} />
          </Field>

          <Field label="Title" error={submit.errors.title?.[0] ?? ""}>
            <Input value={form.title} placeholder="Kids' bike, 16 inch" required attrs={{ maxlength: 80 }} />
          </Field>

          <Field label="Price" error={submit.errors.price?.[0] ?? ""}>
            <div class="price-row row">
              <InputGroup class="price-input" disabled={form.free}>
                <Input value={form.price} placeholder="25" attrs={{ inputmode: "numeric" }} />
                <InputGroupAddon><InputGroupText>$</InputGroupText></InputGroupAddon>
              </InputGroup>
              <Label><Checkbox checked={form.free} /> Free, give it away</Label>
            </div>
          </Field>

          <Field label="Category" error={submit.errors.category?.[0] ?? ""}>
            <NativeSelect value={form.category} placeholder="Choose a category" options={CATEGORY_OPTIONS} block />
          </Field>

          <FieldSet>
            <FieldLegend variant="label">Condition</FieldLegend>
            <ToggleGroup type="single"
                         class="condition-options"
                         variant="outline"
                         label="Condition"
                         value={form.condition}
                         onValueChange={(value, details) => { if (!value) details.cancel(); }}>
              <ToggleGroupItem e:for={c of CONDITIONS} value={c.id}>{c.label}</ToggleGroupItem>
            </ToggleGroup>
            <p e:if={submit.errors.condition} class="error">{submit.errors.condition?.[0]}</p>
          </FieldSet>

          <Field label="Description">
            <Textarea value={form.description} rows={5}
                      placeholder="Size, age, any wear, and when it can be picked up." />
          </Field>

          <div class="sell-actions row">
            <Button variant="ghost" href="/">Cancel</Button>
            <Button type="submit" variant="primary" loading={submit.saving}>Post listing</Button>
          </div>
        </form>
      </main>
    </div>
  </body>
</html>
