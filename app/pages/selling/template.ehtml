import "./style.css";
import { LiveView } from "@elements/app";
import { SiteHeader } from "#app/shared/templates/site-header";
import { Inbox } from "#app/shared/services/conversations";
import { Listing, Status, formatPrice, timeAgo, setStatus } from "#app/shared/services/listings";
import { Button } from "@elements/ui/button";
import { Empty } from "@elements/ui/empty";
import { Item, ItemActions, ItemContent, ItemDescription, ItemGroup, ItemMedia, ItemSeparator, ItemTitle } from "@elements/ui/item";
import { NativeSelect } from "@elements/ui/native-select";

const STATUS_OPTIONS = [
  { value: "available", label: "Available" },
  { value: "pending", label: "Pending" },
  { value: "sold", label: "Sold" },
];

function newestFirst(listings: LiveView<Listing>): Listing[] {
  return listings.sort((a, b) => +b.createdAt - +a.createdAt);
}

function inquiryCount(inbox: Inbox, listingId: string): number {
  return inbox.selling.filter((c) => c.listingId === listingId).length;
}

function plural(n: number, word: string): string {
  return `${n} ${word}${n === 1 ? "" : "s"}`;
}

<MyListing (listing: Listing, view: LiveView<Listing>, inbox: Inbox, first: boolean)>
  <ItemSeparator e:if={!first} />
  <Item class={["my-listing", listing.status === "sold" && "is-sold"].filter(Boolean).join(" ")}>
    <ItemMedia><img src={listing.coverPhoto ?? ""} alt="" width="80" height="60"></ItemMedia>
    <ItemContent>
      <ItemTitle><a href={`/listings/${listing.id}`}>{listing.title}</a></ItemTitle>
      <ItemDescription>{formatPrice(listing.price)} · posted {timeAgo(listing.createdAt)} · {plural(inquiryCount(inbox, listing.id), "conversation")}</ItemDescription>
    </ItemContent>
    <ItemActions>
      <NativeSelect value={listing.status}
                    size="sm"
                    options={STATUS_OPTIONS}
                    attrs={{ "aria-label": `Status of ${listing.title}` }}
                    onchange={(e) => setStatus(view, listing, (e.target as HTMLSelectElement).value as Status)} />
    </ItemActions>
  </Item>
</MyListing>

<html lang="en" class="page-selling" (listings: LiveView<Listing>, inbox: Inbox)>
  <head>
    <title>Selling · swapmeadow</title>
    <meta name="description" content="The things you have listed.">
  </head>
  <body>
    <div class="app">
      <SiteHeader active="selling" {inbox} />

      <main class="app-main page-shell is-form selling stack is-lg">
        <div class="selling-head row">
          <h1>Your listings</h1>
          <Button variant="primary" href="/sell">Post a listing</Button>
        </div>

        <ItemGroup e:if={listings.length > 0} class="my-listings" label="Your listings">
          <MyListing e:for={listing of newestFirst(listings)} {listing} view={listings} {inbox} first={newestFirst(listings).indexOf(listing) === 0} />
        </ItemGroup>

        <div e:else>
          <Empty variant="outline" title="Nothing listed yet." description="Post something you no longer need. Free things go fast." />
        </div>
      </main>
    </div>
  </body>
</html>
