import "./style.css";
import { LiveView } from "@elements/app";
import { Badge } from "@elements/ui/badge";
import { Toggle } from "@elements/ui/toggle";
import { Icon } from "@elements/ui/icon";
import { Listing, formatPrice, conditionLabel, timeAgo } from "#app/shared/services/listings";
import { SavedListing, isSaved, toggleSaved } from "#app/shared/services/saved";

<StatusPill (status: string)>
  <Badge e:if={status === "pending"} variant="warning" dot>Pending</Badge>
  <Badge e:elseif={status === "sold"} variant="secondary">Sold</Badge>
</StatusPill>

<SaveToggle (listingId: string, saved: LiveView<SavedListing>, me: string)>
  <Toggle class="save-toggle" size="sm"
          pressed={isSaved(saved, listingId)}
          label="Save listing"
          onPressedChange={(_, details) => { details.cancel(); toggleSaved(saved, listingId, me); }}>
    <Icon name="heart" size={18} />
  </Toggle>
</SaveToggle>

<ListingCard (listing: Listing, saved: LiveView<SavedListing>, me: string)>
  <li class={["listing-card", listing.status === "sold" && "is-sold"]}>
    <a class="listing-card-link" href={`/listings/${listing.id}`}>
      <div class="listing-card-photo">
        <img e:if={listing.coverPhoto} src={listing.coverPhoto!} alt="" loading="lazy" width="400" height="300">
        <span class="listing-card-status"><StatusPill status={listing.status} /></span>
      </div>
      <div class="listing-card-text">
        <span class={["listing-card-price", listing.price === 0 && "is-free"]}>{formatPrice(listing.price)}</span>
        <span class="listing-card-title">{listing.title}</span>
        <span class="listing-card-meta">{conditionLabel(listing.condition)} · {listing.sellerName} · {timeAgo(listing.createdAt)}</span>
      </div>
    </a>
    <SaveToggle e:if={listing.sellerId !== me} listingId={listing.id} {saved} {me} />
  </li>
</ListingCard>
