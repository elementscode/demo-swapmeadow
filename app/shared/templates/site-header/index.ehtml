import "./style.css";
import { session, redirect } from "@elements/app";
import { Inbox, unreadCount } from "#app/shared/services/conversations";
import { signout } from "#app/shared/services/auth";
import { Button } from "@elements/ui/button";
import { Badge } from "@elements/ui/badge";

function onSignout() {
  signout();
  redirect("/signin");
}

<Logo>
  <svg width="26" height="26" viewBox="0 0 32 32" aria-hidden="true" focusable="false">
    <rect width="32" height="32" rx="9" fill="currentColor"/>
    <path d="M16 25V14" stroke="#fff" stroke-width="2.4" stroke-linecap="round"/>
    <path d="M16 16c0-4.4 3-7.5 8-7.5 0 4.6-3.2 7.5-8 7.5Z" fill="#fff"/>
    <path d="M16 19c0-3.6-2.5-6-6.5-6 0 3.7 2.6 6 6.5 6Z" fill="#fff" opacity=".8"/>
  </svg>
</Logo>

<SiteHeader (active: string, inbox: Inbox)>
  <header class="site-header">
    <div class="page-shell site-header-inner row">
      <div class="row gap-3">
        <a class="site-brand row" href="/">
          <Logo />
          swapmeadow
        </a>
        <span class="site-hood">{session.get("neighborhoodName")}</span>
      </div>

      <nav class="site-nav row" aria-label="Main">
        <a href="/" class={[active === "browse" && "is-active"]}>Browse</a>
        <a href="/saved" class={[active === "saved" && "is-active"]}>Saved</a>
        <a href="/messages" class={[active === "messages" && "is-active"]}>
          Messages
          <Badge e:if={unreadCount(inbox, session.get("userId") ?? "") > 0}
                 class="site-badge"
                 attrs={{ "aria-label": `${unreadCount(inbox, session.get("userId") ?? "")} unread` }}>
            {unreadCount(inbox, session.get("userId") ?? "")}
          </Badge>
        </a>
        <a href="/selling" class={[active === "selling" && "is-active"]}>Selling</a>
        <Button variant="primary" size="sm" href="/sell">Post</Button>
      </nav>

      <Button variant="ghost" size="sm" class="site-signout" onclick={() => onSignout()}>Sign out</Button>
    </div>
  </header>
</SiteHeader>
